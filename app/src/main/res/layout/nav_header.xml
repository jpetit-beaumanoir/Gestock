<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="45sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/nombre_almacen_navigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:text="ALMACÉN"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/codigo_almacen_navigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="código almacén"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintStart_toStartOf="@+id/nombre_almacen_navigation"
        app:layout_constraintTop_toBottomOf="@+id/nombre_almacen_navigation"/>
    <TextView
        android:id="@+id/blackline_textView"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/codigo_almacen_navigation"/>
</androidx.constraintlayout.widget.ConstraintLayout>
