<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/verd_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/titulo_gestion_cajas_almacen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="ARTICULOS PALET X CAJA X"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/descripcion_caja"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:hint="DESCRIPCIÓN"
        android:maxLines="1"
        android:maxLength="15"
        android:inputType="text"
        android:fontFamily="@font/abhaya_libre"
        android:layout_marginStart="10dp"
        android:letterSpacing="0.07"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titulo_gestion_cajas_almacen"/>
    <EditText
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/temporada_caja"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:hint="TEMP"
        android:maxLines="1"
        android:maxLength="4"
        android:inputType="text"
        android:fontFamily="@font/abhaya_libre"
        android:layout_marginStart="15dp"
        android:letterSpacing="0.07"
        app:layout_constraintStart_toEndOf="@+id/descripcion_caja"
        app:layout_constraintTop_toTopOf="@+id/descripcion_caja"/>
    <View
        android:id="@+id/view2"
        android:background="@color/gris_6"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        app:layout_constraintTop_toBottomOf="@+id/descripcion_caja"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/total_productos_caja"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/descripcion_caja"/>
    <LinearLayout
        android:id="@+id/linearLayout_productos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxHeight="430dp"
        app:layout_constraintTop_toBottomOf="@+id/view2">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mostrar_productos"
            android:background="@drawable/border_line_recycler"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="2dp"
            android:maxHeight="450dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/eliminar_productos_caja"
        android:background="@drawable/border_line"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="65dp"
        android:text="ELIMINAR"
        android:fontFamily="@font/abhaya_libre"
        android:layout_marginStart="20dp"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/mover_productos_caja"
        android:background="@drawable/border_line"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:text="MOVER"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/anadir_productos_caja"
        android:background="@drawable/border_line"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="65dp"
        android:text="AÑADIR"
        android:fontFamily="@font/abhaya_libre"
        android:layout_marginEnd="20dp"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/boto_opcions_caixa"
        android:background="@drawable/baseline_keyboard_arrow_down_24"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:rotation="180"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
