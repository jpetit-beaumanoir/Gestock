<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/titulo_pantalla_mover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="MOVER ARTICULOS PALET X CAJA X"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toTopOf="@+id/ean_producto_mover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="25sp"
        android:textColor="@color/black"
        android:id="@+id/ean_producto_mover"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="EAN"
        android:maxLength="13"
        android:inputType="number"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titulo_pantalla_mover"/>
    <EditText
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/ean_caja_destino"
        android:background="@drawable/border_line_edittext"
        android:layout_width="250dp"
        android:layout_height="40dp"
        android:hint="EAN DE LA CAJA"
        android:maxLength="13"
        android:inputType="number"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ean_producto_mover"/>
    <View
        android:id="@+id/view"
        android:background="@color/gris_6"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/ean_caja_destino"/>
    <LinearLayout
        android:id="@+id/linearLayout_productos_mover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxHeight="350dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/total_productos_mover">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mostrar_productos_mover"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxHeight="350dp"/>
    </LinearLayout>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/total_productos_mover"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TOTAL: 0"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toBottomOf="@+id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view"/>
    <CheckBox
        android:textSize="20sp"
        android:textStyle="bold"
        android:id="@+id/checkbox_mover_caja_entera"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="Mover caja entera"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toTopOf="@+id/cancelar_movimiento_productos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/cancelar_movimiento_productos"
        android:background="@drawable/border_line"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="CANCELAR"
        android:fontFamily="@font/abhaya_libre"
        android:layout_marginStart="40dp"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/confirmar_movimiento_productos"
        android:background="@drawable/border_line"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="MOVER"
        android:fontFamily="@font/abhaya_libre"
        android:layout_marginEnd="40dp"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
