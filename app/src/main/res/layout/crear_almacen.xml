<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:text="GESTIÓN ALMACENES"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:maxHeight="400dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mostrar_almacenes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:maxHeight="300dp"/>
    </LinearLayout>
    <EditText
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/codigo_almacen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Código"
        android:maxLength="4"
        android:inputType="number"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintStart_toStartOf="@+id/boton_crear_almacen"
        app:layout_constraintTop_toTopOf="@+id/nombre_almacen"/>
    <EditText
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/nombre_almacen"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:hint="Nombre"
        android:maxLines="1"
        android:scrollHorizontally="true"
        android:maxLength="10"
        android:inputType="text"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toTopOf="@+id/boton_eliminar_almacen"
        app:layout_constraintStart_toStartOf="@+id/boton_eliminar_almacen"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="30dp"
        android:textStyle="bold"
        android:id="@+id/boton_crear_almacen"
        android:background="@drawable/border_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="CREAR"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/boton_eliminar_almacen"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="30dp"
        android:textStyle="bold"
        android:id="@+id/boton_eliminar_almacen"
        android:background="@drawable/border_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="ELIMINAR"
        android:fontFamily="@font/abhaya_libre"
        android:layout_marginStart="30dp"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
