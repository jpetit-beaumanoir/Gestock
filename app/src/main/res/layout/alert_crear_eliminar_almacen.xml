<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start"
    android:padding="15dp"
    android:background="@drawable/border_line_recycler">
    
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:text="CREAR - Para crear un almacén es necesario introducir nombre y código."
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07">
    </TextView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"

        android:text="ELIMINAR - Para eliminar un almacén escribir el código."
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07">
    </TextView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/nombre_almacen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"

            android:hint="Nombre"
            android:textStyle="bold"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"

            android:maxLines="1"
            android:maxLength="14"
            android:inputType="text"
            android:imeOptions="actionNext"

            android:layout_weight="1"/>

        <EditText
            android:id="@+id/codigo_almacen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"

            android:hint="Código"
            android:textStyle="bold"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"

            android:maxLines="1"
            android:maxLength="4"
            android:inputType="number"
            android:imeOptions="actionNext"

            android:layout_weight="1"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/boton_eliminar_almacen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/border_line"

            android:layout_weight="1"
            android:layout_margin="10dp"

            android:alpha="0.5"
            android:enabled="false"

            android:textSize="18sp"
            android:textStyle="bold"
            android:text="ELIMINAR"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/boton_crear_almacen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/border_line"

            android:layout_weight="1"
            android:layout_margin="10dp"

            android:alpha="0.5"
            android:enabled="false"

            android:text="CREAR"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"/>
    </LinearLayout>

    <EditText
        android:id="@+id/key_usuari"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"

        android:hint="ApiKey"
        android:textStyle="bold"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"

        android:visibility="visible"

        android:ellipsize="end"
        android:maxLines="1"
        android:inputType="textPassword"
        android:imeOptions="actionDone"/>

    <TextView
        android:id="@+id/usuari_registrat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:gravity="center"

        android:text="ANÓNIMO"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07" />

</LinearLayout>
