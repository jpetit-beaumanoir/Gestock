<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/border_line_producte"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="5dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"

    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nombre_producto"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"

            android:focusable="false"
            android:clickable="false"

            android:text="NOMBRE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"/>

        <TextView
            android:id="@+id/color_producto"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"

            android:focusable="false"
            android:clickable="false"

            android:text="COLOR"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"/>

        <TextView
            android:id="@+id/ean_producto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:focusable="false"
            android:clickable="false"

            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:text="1234567890123"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/temporada_producto"
            android:layout_width="wrap_content"
            android:layout_height="0dp"

            android:layout_weight="1"
            android:gravity="center"

            android:focusable="false"
            android:clickable="false"

            android:text="TEMP"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07" />

        <TextView
            android:id="@+id/talla_producto"
            android:layout_width="wrap_content"
            android:layout_height="0dp"

            android:layout_weight="1"
            android:gravity="center"

            android:focusable="false"
            android:clickable="false"

            android:text="TALLA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"/>

    </LinearLayout>


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/stock_beepeado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:focusable="false"
            android:clickable="false"

            android:text="0"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07" />

        <TextView
            android:id="@+id/slash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:focusable="false"
            android:clickable="false"

            android:text="/"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"/>

        <TextView
            android:id="@+id/productos_totales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:focusable="false"
            android:clickable="false"

            android:text="2"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"/>

    </LinearLayout>

</LinearLayout>
