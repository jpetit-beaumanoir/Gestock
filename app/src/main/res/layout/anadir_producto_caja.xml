<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/afegir_articles_background"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/titulo_pantalla_anadir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:text="AÑADIR ARTICULOS PALET X CAJA X"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"/>

    <EditText
        android:id="@+id/ean_producto_anadir"
        android:layout_width="250dp"
        android:layout_height="40dp"
        android:background="@drawable/border_line_edittext"

        android:gravity="center"
        android:layout_margin="30dp"

        android:hint="EAN"
        android:textSize="20sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:maxLength="13"
        android:inputType="number"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"/>

    <TextView
        android:id="@+id/total_productos_anadir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gris_6"

        android:gravity="center"
        android:padding="5dp"
        android:layout_marginBottom="5dp"

        android:text="TOTAL: 0"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"/>

    <LinearLayout
        android:id="@+id/linearLayout_productos_anadir"
        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mostrar_productos_anadir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:layout_margin="20dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cancelar_adicion_productos"
            android:background="@drawable/border_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"
            android:layout_margin="5dp"

            android:text="CANCELAR"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/confirmar_adicion_productos"
            android:background="@drawable/border_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"
            android:layout_margin="5dp"

            android:text="ACEPTAR"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"/>

    </LinearLayout>


</LinearLayout>
