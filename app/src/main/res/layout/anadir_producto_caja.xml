<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:background="@drawable/afegir_articles_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/titulo_pantalla_anadir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AÑADIR ARTICULOS PALET X CAJA X"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toTopOf="@+id/ean_producto_anadir"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="25sp"
        android:textColor="@color/black"
        android:id="@+id/ean_producto_anadir"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:hint="EAN"
        android:maxLength="13"
        android:inputType="number"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view"
        android:background="@color/gris_6"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@+id/ean_producto_anadir"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/total_productos_anadir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TOTAL: 0"
        android:fontFamily="@font/abhaya_libre"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toBottomOf="@+id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/view"
        app:layout_constraintTop_toBottomOf="@+id/ean_producto_anadir"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linearLayout_productos_anadir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxHeight="450dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mostrar_productos_anadir"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="450dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/cancelar_adicion_productos"
        android:background="@drawable/border_line"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="CANCELAR"
        android:fontFamily="@font/abhaya_libre"
        android:layout_marginStart="40dp"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@+id/confirmar_adicion_productos"
        android:background="@drawable/border_line"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="ACEPTAR"
        android:fontFamily="@font/abhaya_libre"
        android:layout_marginEnd="40dp"
        android:letterSpacing="0.07"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
