<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout_almacen_virtual_main_cajas"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/linearlayout_almacen_virtual_main_cajas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/almacen_cajas_background"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_margin="10dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/refresh_button_cajas"
                android:background="@drawable/refresh_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"/>

            <TextView
                android:id="@+id/numero_palet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"
                android:gravity="center"

                android:text="CAJAS PALET 3"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:fontFamily="@font/abhaya_libre"
                android:letterSpacing="0.07"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/boton_menu"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/menu_icon_24" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mostrar_cajas_almacen"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/anadir_caja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/border_line"

            android:layout_margin="20dp"

            android:text="AÑADIR CAJA"
            android:textSize="28sp"
            android:textColor="@color/black"
            android:fontFamily="@font/abhaya_libre"
            android:letterSpacing="0.07"/>

    </LinearLayout>
    <include layout="@layout/menu_stocksearch"/>
</androidx.drawerlayout.widget.DrawerLayout>
